# Copia este archivo como .env y ajusta los valores
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl
POSTGRES_DB=secop

# Alcance de la extracción
SECOP_DEPARTAMENTO=Tolima
SECOP_FECHA_DESDE=2026-01-01
